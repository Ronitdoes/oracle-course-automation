# --- LLM ---
LLM_PROVIDER=mock
MODEL_ID=mock-model
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Gemini (native): LLM_PROVIDER=gemini, MODEL_ID=gemini-2.0-flash,
# LLM_API_KEY=<key from https://aistudio.google.com/apikey>.
# (Gemini also works via LLM_PROVIDER=openai + LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai.)
# Set MOCK_SOLVER_MODE=auto to answer fixture questions without credentials.
# Use MOCK_SOLVER_MODE=unresolved to force unresolved answers (tests recovery).
MOCK_SOLVER_MODE=auto

# --- Target ---
TARGET_URL=file:///D:/projects/Browser-Automation/tests/fixture/quiz.html
ALLOWED_DOMAINS=

# --- Browser ---
HEADLESS=true
BROWSER_CONNECTION_MODE=launch
CDP_ENDPOINT=http://localhost:9222
NAVIGATION_TIMEOUT_MS=15000
ACTION_TIMEOUT_MS=8000

# --- Run limits ---
MAX_QUESTIONS=20
MAX_RETRIES=2
MAX_ACTIONS=50
RUN_MAX_DURATION_SEC=300

# --- Storage / diagnostics ---
SCREENSHOT_DIR=./artifacts/screenshots
DATABASE_PATH=./artifacts/runs.sqlite
LOG_LEVEL=INFO

# --- Safety ---
DRY_RUN=false
REQUIRE_APPROVAL=false
# Walk course pages by itself: clicks Save and Continue on theory pages,
# then Take an Assessment and Start to open the quiz. Off by default
# (questions only). Practice pages are plain reading pages too, so they
# are included.
AUTO_ADVANCE_LESSONS=false
# Finished sections are remembered in the history file so they are never
# redone, even if the outline still shows them open. Set to true only to
# allow redoing a recorded section on purpose.
REDO_FINISHED_SECTIONS=false

# --- Privacy ---
REDACT_QUESTION_TEXT_IN_LOGS=false
PERSIST_QUESTION_TEXT=true
